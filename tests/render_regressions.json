    },
    "cloud_determinism": {
      "kind": "image_ab",
      "camera": "10000,30000,10000,225,5",
      "max_mean": 1.0,
      "captures": [
        {"name": "a", "env": {"FURY_CLOUD_COVERAGE": "0.5"}},
        {"name": "b", "env": {"FURY_CLOUD_COVERAGE": "0.5"}}
      ]
    },
    "prez_image_ab": {
      "kind": "image_ab",
      "camera": "10000,300,11500,200,10",
      "capture_frame": 60,
      "max_mean": 0.5,
      "max_frac": 0.01,
      "captures": [
        {"name": "on", "env": {"FURY_VEG_PREZ": "1"}},
        {"name": "off", "env": {"FURY_VEG_PREZ": "0"}}
