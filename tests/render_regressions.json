{
  "version": 1,
  "defaults": {
    "script": "{tests}/lua/scenes/cloud_visual_check.lua",
    "backend": "opengl",
    "capture_frame": 40,
    "timeout": 240,
    "env": {
      "FURY_CLOUD_FREEZE": "1"
    }
  },
  "cases": {
    "cloud_coverage_sweep": {
      "kind": "coverage_sweep",
      "camera": "10000,30000,10000,225,5",
      "region": "0,40,1280,300",
      "captures": [
        {"name": "cov005", "env": {"FURY_CLOUD_COVERAGE": "0.05"}},
        {"name": "cov035", "env": {"FURY_CLOUD_COVERAGE": "0.35"}},
        {"name": "cov080", "env": {"FURY_CLOUD_COVERAGE": "0.8"}}
      ]
    },
    "cloud_tod_tint": {
      "kind": "tod_tint",
      "camera": "10000,30000,10000,225,5",
      "region": "0,40,1280,300",
      "grid": "8,4",
      "min_ratio": 1.1,
      "captures": [
        {"name": "noon", "env": {"FURY_TOD_HOURS": "12", "FURY_CLOUD_COVERAGE": "0.5"}},
        {"name": "sunset", "env": {"FURY_TOD_HOURS": "17.6", "FURY_CLOUD_COVERAGE": "0.5"}}
      ]
    },
    "cloud_occlusion_terrain": {
      "kind": "occlusion",
      "camera": "10000,300,11500,200,10",
      "captures": [
        {"name": "on", "env": {"FURY_CLOUD_COVERAGE": "0.6"}},
        {"name": "off", "env": {"FURY_CLOUD_OFF": "1"}}
      ],
      "regions": [
        {"name": "opaque", "rect": "0,520,1280,700", "max_mean": 0.5},
        {"name": "sky", "rect": "0,40,1280,300", "min_mean": 2.0}
      ]
    },
    "cloud_occlusion_deck": {
      "kind": "occlusion",
      "camera": "10500,300,9500,225,6",
      "captures": [
        {"name": "on", "env": {"FURY_CLOUD_ALT": "0.05", "FURY_CLOUD_THICK": "1.0", "FURY_CLOUD_DENSITY": "30", "FURY_CLOUD_COVERAGE": "0.6"}},
        {"name": "off", "env": {"FURY_CLOUD_OFF": "1"}}
