# Build directories
/engine/build/
/engine/lib/
/build-engine/
/build-engine-noeditor/
/build-demo/
/build/
/build-*/
/cmake-build-*/

# CMake artifacts (defense-in-depth in case someone configures in-tree)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cbp
compile_commands.json

# Demo runtime artifacts dropped next to the binary
/examples/bin/Log.txt
/examples/bin/demo
/examples/bin/fury
/examples/bin/libfury.dylib
/examples/bin/libsfml-*.dylib
/examples/bin/libfury.so
/examples/bin/libfury.a
/examples/bin/*.pdb
# Lua scripts get staged into bin/ when running; the canonical copy lives in examples/.
/examples/bin/*.lua

# Since the editor refactor, fury is built directly into examples/ and the
# CWD-resolved Resource/ tree sits next to it. Runtime artifacts:
/examples/Log.txt
/examples/fury
/examples/furye
/examples/furye-cli
/examples/ktx
/examples/ktx.exe
/examples/libktx*.dylib
/examples/DDC/

# Cook/package pipeline outputs (regenerate via furye-cli cook/package)
*.cookmanifest.json
*.pak
/examples/KrautCLI
/examples/KrautPreview
/examples/tracy-profiler
/examples/tracy-capture
/examples/FBX2glTF-darwin-x64
/examples/FBX2glTF-windows-x64.exe
/examples/FBX2glTF-linux-x64
/examples/libfury.dylib
/examples/libsfml-*.dylib
/examples/libfury.so
/examples/libfury.a
/examples/*.pdb

# Editor thumbnail cache (regenerated on demand)
/examples/Resource/.thumbcache/

# Cross-compiled MSL cache (the Metal backend writes <shader>.metal next to
# the .glsl source; regenerated by the Slang/SPIRV-Cross pipeline)
/examples/Resource/Shader/**/*.metal

# Staged Slang compiler CLI (build output, staged next to each binary)
/examples/slang

# Vendored Slang compiler prebuilts: pinned upstream release, fetched by
# CMake into the local tree (see tools/cmake/FetchPinnedArchive.cmake).
# The platform payload dirs are ignored; this README stays tracked.
/engine/ThirdParty/slang/*/
/engine/ThirdParty/MoltenVK/*/
/examples/libMoltenVK.dylib
/examples/MoltenVK_icd.json

# Out-of-tree build dirs beyond the ones listed above
/build-debug/
/Log.txt

# Editor / IDE
*.sublime-project
*.sublime-workspace
.vscode/
.idea/
*.code-workspace

# Tooling-specific (user-local session state)
.claude/
.codebuddy/
.diffcue/
.kimi/

# OS noise
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Backup / swap
*.bak
*.swp
*.swo
*~

# ImGui runtime layout state
imgui.ini
examples/bin/FBX2glTF-darwin-x64

# Manual play-test scratch scenes dropped under examples/Resource/Scene/
# during editor testing (Save As, open-by-name, etc.). Real scene assets
# are tracked; these are user-local one-offs.
examples/Resource/Scene/outdoor.json
examples/Resource/Scene/scene_saved.json

# Per-project JSON shadow of an existing .bin — keep .bin (LZ4-compressed,
# smaller) as the runtime form. JSON versions get staged when the editor
# does File→Save or the CLI's `convert` writes both; .bin is canonical.
examples/Projects/*/*.json
examples/Projects/samples/*/*.json

# Per-user settings file written by game demos (Options panel persistence)
examples/Projects/*/game_settings.cfg
examples/Projects/samples/*/game_settings.cfg

# Play-mode temp scenes (editor Play writes <scene dir>/.play_<name>.tmp.bin)
.play_*.tmp.bin

# Volumetric cloud noise cache (SkyAtmosphere generates at load, does
# glTexSubImage#get... readback, cache file). Set per-machine.
cloud_noise_*.bin
examples/Cache/**

# ASAN scratch build dir
/build-asan/
